"NSBluetoothAlwaysUsageDescription" = "Fjelia connects to health and training devices to record ECG, heart rate and workout data, including while the screen is locked.";
"NSBluetoothPeripheralUsageDescription" = "Fjelia uses Bluetooth to connect to your health devices.";
"NSHealthShareUsageDescription" = "Fjelia reads your health data (sleep, heart rate, HRV, steps, SpO2) from Apple Health to give you personalised training insights.";
"NSHealthUpdateUsageDescription" = "Fjelia writes your synced HRV, heart rate, sleep, steps and workout data to Apple Health so you don't lose it if you switch apps.";

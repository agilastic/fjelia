"NSLocationWhenInUseUsageDescription" = "Fjelia uses location for workout routes when you enable GPS and to evaluate heat risk for planned workouts.";
"NSPhotoLibraryUsageDescription" = "Fjelia lets you add photos and videos from your library to your workouts, race goals and planned sessions.";
"NSCameraUsageDescription" = "Fjelia uses the camera when you take a photo or video for a workout, race goal or planned session.";
"NSMicrophoneUsageDescription" = "Fjelia uses the microphone for the sound of videos you record for a workout.";
